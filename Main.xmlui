<App
  var.cities="{(() => { try { const s = localStorage.getItem('weather.cities'); return s ? JSON.parse(s) : ['Albany, CA']; } catch (e) { return ['Albany, CA']; } })()}"
  var.selectedCity="{(() => { try { return localStorage.getItem('weather.selectedCity') || 'Albany, CA'; } catch (e) { return 'Albany, CA'; } })()}"
  var.cityInput=""
  var.errorMessage=""
  var.tempUnit="F"
  var.condition="{ weatherData.value.current_condition[0] }"
  var.nearest_area="{ weatherData.value.nearest_area[0] }"
  var.astronomy="{ weatherData.value.weather[0].astronomy[0] }"
  var.region="{ nearest_area.region && nearest_area.region[0] && nearest_area.region[0].value }"
>
  <AppHeader>
    <property name="profileMenuTemplate">
      <Inspector />
    </property>
  </AppHeader>

  <DataSource
    id="weatherData"
    url="https://wttr.in/{selectedCity}?format=j1"
    errorNotificationMessage=""
    onError="(error) => { errorMessage = 'Could not find weather data for ' + selectedCity + '. Please check the city name.'; }" />

  <VStack width="100%" gap="$gap-normal" padding="$space-3">

    <HStack width="100%" verticalAlignment="center">
      <H1>Weather Dashboard</H1>
      <SpaceFiller />
      <RadioGroup
        initialValue="{tempUnit}"
        onDidChange="(val) => { tempUnit = val; }">
        <HStack>
          <Option label="°F" value="F" />
          <Option label="°C" value="C" />
        </HStack>
      </RadioGroup>
    </HStack>

    <Text when="{errorMessage}" variant="destructive">
      {errorMessage}
    </Text>

    <HStack width="100%" gap="$gap-normal" verticalAlignment="start">

      <VStack width="16rem" minWidth="14rem" gap="$gap-tight">
        <Text variant="secondary" fontSize="$fontSize-sm" fontWeight="semibold">CITIES</Text>
        <Items data="{cities}">
          <CitySidebarRow
            city="{$item}"
            tempUnit="{tempUnit}"
            selected="{$item === selectedCity}"
            canMoveUp="{!$isFirst}"
            canMoveDown="{!$isLast}"
            onSelect="(city) => {
              selectedCity = city;
              errorMessage = '';
              try { localStorage.setItem('weather.selectedCity', city); } catch (e) {}
            }"
            onRemove="(city) => {
              const newCities = cities.filter(c => c !== city);
              cities = newCities.length ? newCities : ['Albany, CA'];
              if (selectedCity === city) {
                selectedCity = cities[0];
                try { localStorage.setItem('weather.selectedCity', cities[0]); } catch (e) {}
              }
              try { localStorage.setItem('weather.cities', JSON.stringify(cities)); } catch (e) {}
            }"
            onMoveUp="(city) => {
              const i = cities.indexOf(city);
              if (i <= 0) return;
              const newCities = [...cities];
              newCities[i - 1] = city;
              newCities[i] = cities[i - 1];
              cities = newCities;
              try { localStorage.setItem('weather.cities', JSON.stringify(newCities)); } catch (e) {}
            }"
            onMoveDown="(city) => {
              const i = cities.indexOf(city);
              if (i < 0 || i >= cities.length - 1) return;
              const newCities = [...cities];
              newCities[i + 1] = city;
              newCities[i] = cities[i + 1];
              cities = newCities;
              try { localStorage.setItem('weather.cities', JSON.stringify(newCities)); } catch (e) {}
            }" />
        </Items>

        <VStack gap="$space-1" paddingTop="$space-2">
          <TextBox
            id="addCityBox"
            enabled="{!weatherData.inProgress}"
            placeholder="Add a city..."
            initialValue="{cityInput}"
            onDidChange="(val) => { cityInput = val; }" />
          <Button
            label="Add"
            width="100%"
            enabled="{cityInput.trim().length > 0}"
            onClick="() => {
              const trimmed = cityInput.trim();
              if (!trimmed) return;
              const newCities = cities.includes(trimmed) ? cities : [...cities, trimmed];
              cities = newCities;
              selectedCity = trimmed;
              cityInput = '';
              errorMessage = '';
              try { localStorage.setItem('weather.cities', JSON.stringify(newCities)); } catch (e) {}
              try { localStorage.setItem('weather.selectedCity', trimmed); } catch (e) {}
            }" />
        </VStack>
      </VStack>

      <VStack width="*" minWidth="0" gap="$gap-normal">

        <VStack
          when="{weatherData.inProgress}"
          horizontalAlignment="center">
          <Spinner />
          <Text variant="secondary">
            Loading weather data...
          </Text>
        </VStack>

        <VStack
          when="{weatherData.loaded && weatherData.value && !errorMessage}"
          width="100%"
          maxWidth="42rem"
          backgroundColor="$color-background-secondary"
          padding="$space-3"
          borderRadius="$borderRadius">

          <VStack gap="0">
            <H2>{selectedCity}</H2>
            <Text breakMode="word" variant="secondary">
              { region ? region + ', ' : ''}{nearest_area.country[0].value}
            </Text>
          </VStack>

          <HStack verticalAlignment="center" wrapContent="true">
            <HStack verticalAlignment="center">
              <Text fontSize="4rem" fontWeight="bold">
                {tempUnit === 'C' ? condition.temp_C : condition.temp_F}°
              </Text>
              <Text fontSize="2rem" variant="secondary">
                {tempUnit}
              </Text>
              <Text fontSize="$fontSize-xl" fontWeight="semibold">
                {condition.weatherDesc[0].value}
              </Text>
            </HStack>
            <Text variant="secondary" fontSize="$fontSize-lg">
              Feels like {tempUnit === 'C' ? condition.FeelsLikeC : condition.FeelsLikeF}°{tempUnit}
            </Text>
          </HStack>

          <HStack width="100%" wrapContent="true">
            <WeatherStat width="9rem" label="Cloud Cover" value="{condition.cloudcover}%" />
            <WeatherStat width="9rem" label="Humidity" value="{condition.humidity}%" />
            <WeatherStat width="9rem" label="Wind Speed" value="{condition.windspeedMiles} mph" />
            <WeatherStat width="9rem" label="Pressure" value="{condition.pressure} mb" />
          </HStack>

          <HStack width="100%" wrapContent="true">
            <WeatherStat width="9rem" label="Sunrise" value="{astronomy.sunrise}" />
            <WeatherStat width="9rem" label="Sunset" value="{astronomy.sunset}" />
            <WeatherStat width="9rem" label="Moonrise" value="{astronomy.moonrise}" />
            <WeatherStat width="9rem" label="Moonset" value="{astronomy.moonset}" />
          </HStack>

          <VStack width="100%">
            <H3>3-Day Forecast</H3>
            <HStack wrapContent="true" gap="$gap-normal">
              <Items data="{weatherData.value.weather}">
                <VStack
                  width="11rem"
                  paddingHorizontal="$space-3"
                  paddingVertical="$space-2"
                  backgroundColor="$color-surface-100"
                  borderRadius="$borderRadius"
                  gap="$gap-tight"
                  horizontalAlignment="center">
                  <Text fontWeight="semibold">
                    {new Date($item.date + 'T00:00:00').toLocaleDateString('en-US', {weekday: 'short', month: 'short', day: 'numeric'})}
                  </Text>
                  <Text variant="secondary" fontSize="$fontSize-sm">
                    {$item.hourly[4].weatherDesc[0].value}
                  </Text>
                  <HStack gap="$gap-tight" verticalAlignment="center">
                    <Text fontSize="$fontSize-lg" fontWeight="bold">
                      {tempUnit === 'C' ? $item.maxtempC : $item.maxtempF}°
                    </Text>
                    <Text variant="secondary">
                      / {tempUnit === 'C' ? $item.mintempC : $item.mintempF}°
                    </Text>
                  </HStack>
                  <Text variant="secondary" fontSize="$fontSize-sm">
                    💧 {$item.hourly[4].chanceofrain}%
                  </Text>
                </VStack>
              </Items>
            </HStack>
          </VStack>

        </VStack>

        <Text
          when="{!weatherData.loaded && !weatherData.inProgress}"
          variant="secondary">
          Select a city from the sidebar or add one below.
        </Text>

      </VStack>

    </HStack>

  </VStack>

</App>
